    <joint name="infeed_lift_joint" type="prismatic">
      <parent>infeed_base</parent>
      <child>infeed_lift</child>
      <pose relative_to="infeed_lift">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <velocity>0.12</velocity>
          <effort>2000</effort>
          <lower>0</lower>
          <upper>0.25</upper>
        </limit>
        <dynamics>
          <damping>4</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>
    <joint name="infeed_extension_joint" type="prismatic">
      <parent>infeed_lift</parent>
      <child>infeed_carriage</child>
      <pose relative_to="infeed_carriage">0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <velocity>0.12</velocity>
          <effort>800</effort>
          <lower>0</lower>
          <upper>0.4</upper>
        </limit>
        <dynamics>
          <damping>4</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>
    <joint name="infeed_belt_mount" type="fixed">
      <parent>infeed_carriage</parent>
      <child>infeed_belt</child>
      <pose relative_to="infeed_belt">0 0 0 0 0 0</pose>
    </joint>
    <joint name="infeed_rear_roller_joint" type="revolute">
      <parent>infeed_carriage</parent>
      <child>infeed_rear_roller</child>
      <pose relative_to="infeed_rear_roller">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <velocity>165</velocity>
          <effort>20</effort>
        </limit>
        <dynamics>
          <damping>.02</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>
    <joint name="infeed_front_roller_joint" type="revolute">
      <parent>infeed_carriage</parent>
      <child>infeed_front_roller</child>
      <pose relative_to="infeed_front_roller">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <velocity>165</velocity>
          <effort>20</effort>
        </limit>
        <dynamics>
          <damping>.02</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>infeed_lift_joint</joint_name>
      <topic>/model/bellybot_infeed/lift_target</topic>
      <initial_position>0</initial_position>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>0.12</cmd_max>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>infeed_extension_joint</joint_name>
      <topic>/model/bellybot_infeed/extension_target</topic>
      <initial_position>0.4</initial_position>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>0.12</cmd_max>
    </plugin>
    <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
      <link>infeed_belt</link>
      <velocity_topic>/model/bellybot_infeed/belt_speed</velocity_topic>
      <track_orientation>0 3.141592653589793 0</track_orientation>
      <max_command_age>0.5</max_command_age>
      <min_velocity>-1.5</min_velocity>
      <max_velocity>1.5</max_velocity>
      <min_acceleration>-3</min_acceleration>
      <max_acceleration>3</max_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>infeed_front_roller_joint</joint_name>
      <joint_name>infeed_rear_roller_joint</joint_name>
      <topic>/model/bellybot_infeed/roller_speed</topic>
      <initial_velocity>0</initial_velocity>
      <use_force_commands>false</use_force_commands>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/bellybot_infeed/joint_states</topic>
    </plugin>
  </model>
</sdf>