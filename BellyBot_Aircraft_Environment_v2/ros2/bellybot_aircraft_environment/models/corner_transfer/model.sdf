    <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
      <link>corner_belt</link>
      <velocity_topic>/environment/corner_belt/speed</velocity_topic>
      <track_orientation>0 3.141592653589793 0</track_orientation>
      <max_command_age>0.35</max_command_age>
      <min_velocity>-1.2</min_velocity>
      <max_velocity>1.2</max_velocity>
      <min_acceleration>-1.2</min_acceleration>
      <max_acceleration>1.2</max_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>corner_belt_rear_joint</joint_name>
      <topic>/environment/corner_belt/roller_speed</topic>
      <use_force_commands>false</use_force_commands>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>corner_belt_front_joint</joint_name>
      <topic>/environment/corner_belt/roller_speed</topic>
      <use_force_commands>false</use_force_commands>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>corner_rotor_joint</joint_name>
      <topic>/environment/corner/angle</topic>
      <p_gain>500</p_gain>
      <i_gain>10</i_gain>
      <d_gain>50</d_gain>
      <cmd_max>300</cmd_max>
      <cmd_min>-300</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/corner_transfer/joint_states</topic>
    </plugin>
