          <lower>0</lower>
          <upper>0.11333333333333334</upper>
          <effort>2500</effort>
          <velocity>0.18</velocity>
        </limit>
        <dynamics>
          <damping>0.3</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="corner_stage_3_joint" type="prismatic">
      <parent>corner_stage_2</parent>
      <child>corner_stage_3</child>
      <pose relative_to="corner_stage_3">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.11333333333333334</upper>
          <effort>2500</effort>
          <velocity>0.18</velocity>
        </limit>
        <dynamics>
          <damping>0.3</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="corner_rotor_joint" type="revolute">
      <parent>corner_stage_3</parent>
      <child>corner_rotor</child>
      <pose relative_to="corner_rotor">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>0</lower>
          <upper>1.5707963267948966</upper>
          <effort>120</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics>
          <damping>0.3</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="corner_belt_joint" type="fixed">
      <parent>corner_rotor</parent>
      <child>corner_belt</child>
      <pose relative_to="corner_belt">0 0 0 0 0 0</pose>
    </joint>
    <joint name="corner_belt_rear_joint" type="revolute">
      <parent>corner_rotor</parent>
      <child>corner_belt_rear</child>
      <pose relative_to="corner_belt_rear">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>120</effort>
          <velocity>120</velocity>
        </limit>
        <dynamics>
          <damping>0.3</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="corner_belt_front_joint" type="revolute">
      <parent>corner_rotor</parent>
      <child>corner_belt_front</child>
      <pose relative_to="corner_belt_front">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>120</effort>
          <velocity>120</velocity>
        </limit>
        <dynamics>
          <damping>0.3</damping>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>corner_stage_1_joint</joint_name>
      <topic>/environment/corner/stage_1</topic>
      <p_gain>250000</p_gain>
      <i_gain>4000</i_gain>
      <d_gain>1000</d_gain>
      <i_max>4000</i_max>
      <i_min>-4000</i_min>
      <cmd_max>6000</cmd_max>
      <cmd_min>-6000</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
