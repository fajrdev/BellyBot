          <ixx>0.018836166666666664</ixx>
          <iyy>4.033333333333339e-05</iyy>
          <izz>0.018836166666666664</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>
      <visual name="corner_belt_front_visual">
        <geometry>
          <mesh>
            <uri>model://corner_transfer/meshes/corner_belt_front.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="corner_stage_1_joint" type="prismatic">
      <parent>corner_base</parent>
      <child>corner_stage_1</child>
      <pose relative_to="corner_stage_1">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.11333333333333334</upper>
          <effort>2500</effort>
          <velocity>0.18</velocity>
        </limit>
        <dynamics>
          <damping>0.3</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="corner_stage_2_joint" type="prismatic">
      <parent>corner_stage_1</parent>
