    </joint>
    <joint name="door_belt_contact_rear_joint" type="revolute">
      <parent>door_belt_frame</parent>
      <child>door_belt_contact_rear</child>
      <pose relative_to="door_belt_contact_rear">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>120</effort>
          <velocity>120</velocity>
        </limit>
        <dynamics>
          <damping>0.3</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="door_belt_contact_front_joint" type="revolute">
      <parent>door_belt_frame</parent>
      <child>door_belt_contact_front</child>
      <pose relative_to="door_belt_contact_front">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>120</effort>
          <velocity>120</velocity>
        </limit>
        <dynamics>
          <damping>0.3</damping>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
      <link>door_belt_contact</link>
      <velocity_topic>/environment/door_belt_contact/speed</velocity_topic>
      <track_orientation>0 3.141592653589793 0</track_orientation>
      <max_command_age>0.35</max_command_age>
      <min_velocity>-1.2</min_velocity>
      <max_velocity>1.2</max_velocity>
      <min_acceleration>-1.2</min_acceleration>
      <max_acceleration>1.2</max_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>door_belt_contact_rear_joint</joint_name>
      <topic>/environment/door_belt_contact/roller_speed</topic>
      <use_force_commands>false</use_force_commands>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>door_belt_contact_front_joint</joint_name>
      <topic>/environment/door_belt_contact/roller_speed</topic>
