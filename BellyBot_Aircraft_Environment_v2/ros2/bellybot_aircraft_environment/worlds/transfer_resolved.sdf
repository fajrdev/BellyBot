          <dynamics>
            <damping>4</damping>
            <friction>0</friction>
          </dynamics>
        </axis>
      </joint>
      <joint name="yaw_joint" type="revolute">
        <parent>lift_stage_3</parent>
        <child>yaw_carrier</child>
        <pose relative_to="yaw_carrier">0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <velocity>1.0</velocity>
            <effort>300</effort>
            <lower>-1.6580627893946132</lower>
            <upper>1.6580627893946132</upper>
          </limit>
          <dynamics>
            <damping>4</damping>
            <friction>0</friction>
          </dynamics>
        </axis>
      </joint>
      <joint name="extension_mid_joint" type="prismatic">
        <parent>yaw_carrier</parent>
        <child>extension_mid</child>
        <pose relative_to="extension_mid">0 0 0 0 0 0</pose>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <velocity>0.7</velocity>
            <effort>1400</effort>
            <lower>0</lower>
            <upper>0.5</upper>
          </limit>
          <dynamics>
            <damping>4</damping>
            <friction>0</friction>
          </dynamics>
        </axis>
      </joint>
      <joint name="extension_tip_joint" type="prismatic">
        <parent>extension_mid</parent>
        <child>tray_carriage</child>
        <pose relative_to="tray_carriage">0 0 0 0 0 0</pose>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <velocity>0.7</velocity>
            <effort>1400</effort>
            <lower>0</lower>
            <upper>0.5</upper>
          </limit>
          <dynamics>
            <damping>4</damping>
            <friction>0</friction>
          </dynamics>
        </axis>
      </joint>
      <joint name="tray_pitch_joint" type="revolute">
        <parent>tray_carriage</parent>
        <child>tray</child>
        <pose relative_to="tray">0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <velocity>0.6</velocity>
            <effort>450</effort>
            <lower>0</lower>
            <upper>0.5585053606381855</upper>
          </limit>
          <dynamics>
            <damping>4</damping>
            <friction>0</friction>
          </dynamics>
        </axis>
      </joint>
      <joint name="tray_belt_mount" type="fixed">
        <parent>tray</parent>
        <child>tray_belt</child>
        <pose relative_to="tray_belt">0 0 0 0 0 0</pose>
      </joint>
      <joint name="tray_rear_roller_joint" type="revolute">
        <parent>tray</parent>
        <child>tray_rear_roller</child>
        <pose relative_to="tray_rear_roller">0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <velocity>165</velocity>
            <effort>20</effort>
          </limit>
          <dynamics>
            <damping>.02</damping>
            <friction>0</friction>
          </dynamics>
        </axis>
      </joint>
      <joint name="tray_front_roller_joint" type="revolute">
        <parent>tray</parent>
        <child>tray_front_roller</child>
        <pose relative_to="tray_front_roller">0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <velocity>165</velocity>
            <effort>20</effort>
          </limit>
          <dynamics>
            <damping>.02</damping>
            <friction>0</friction>
          </dynamics>
        </axis>
      </joint>
      <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
        <link>left_track_link</link>
        <velocity_topic>/model/bellybot_dock_stack/left_track_velocity</velocity_topic>
        <track_orientation>0 0 0</track_orientation>
        <max_command_age>0.5</max_command_age>
        <min_velocity>-0.4</min_velocity>
        <max_velocity>0.4</max_velocity>
        <min_acceleration>-1</min_acceleration>
        <max_acceleration>1</max_acceleration>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>left_wheel_0_joint</joint_name>
        <joint_name>left_wheel_1_joint</joint_name>
        <joint_name>left_wheel_2_joint</joint_name>
        <joint_name>left_wheel_3_joint</joint_name>
        <joint_name>left_wheel_4_joint</joint_name>
        <topic>/model/bellybot_dock_stack/left_wheel_speed</topic>
        <initial_velocity>0</initial_velocity>
        <use_force_commands>false</use_force_commands>
      </plugin>
      <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
        <link>right_track_link</link>
        <velocity_topic>/model/bellybot_dock_stack/right_track_velocity</velocity_topic>
        <track_orientation>0 0 0</track_orientation>
        <max_command_age>0.5</max_command_age>
        <min_velocity>-0.4</min_velocity>
        <max_velocity>0.4</max_velocity>
        <min_acceleration>-1</min_acceleration>
        <max_acceleration>1</max_acceleration>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>right_wheel_0_joint</joint_name>
        <joint_name>right_wheel_1_joint</joint_name>
        <joint_name>right_wheel_2_joint</joint_name>
        <joint_name>right_wheel_3_joint</joint_name>
        <joint_name>right_wheel_4_joint</joint_name>
        <topic>/model/bellybot_dock_stack/right_wheel_speed</topic>
        <initial_velocity>0</initial_velocity>
        <use_force_commands>false</use_force_commands>
      </plugin>
      <plugin filename="gz-sim-tracked-vehicle-system" name="gz::sim::systems::TrackedVehicle">
        <left_track>
          <link>left_track_link</link>
          <velocity_topic>/model/bellybot_dock_stack/left_track_velocity</velocity_topic>
        </left_track>
        <right_track>
          <link>right_track_link</link>
          <velocity_topic>/model/bellybot_dock_stack/right_track_velocity</velocity_topic>
        </right_track>
        <tracks_separation>0.75</tracks_separation>
        <track_height>0.164</track_height>
        <steering_efficiency>1</steering_efficiency>
        <topic>/model/bellybot_dock_stack/cmd_vel</topic>
        <linear_velocity>
          <min_velocity>-0.2</min_velocity>
          <max_velocity>0.2</max_velocity>
          <min_acceleration>-0.3</min_acceleration>
          <max_acceleration>0.3</max_acceleration>
        </linear_velocity>
        <angular_velocity>
          <min_velocity>-0.25</min_velocity>
          <max_velocity>0.25</max_velocity>
          <min_acceleration>-0.4</min_acceleration>
          <max_acceleration>0.4</max_acceleration>
        </angular_velocity>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>lift_stage_1_joint</joint_name>
        <joint_name>lift_stage_2_joint</joint_name>
        <joint_name>lift_stage_3_joint</joint_name>
        <topic>/model/bellybot_dock_stack/lift_stage_target</topic>
        <initial_position>0</initial_position>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>0.12</cmd_max>
