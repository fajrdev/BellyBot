      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>extension_mid_joint</joint_name>
        <joint_name>extension_tip_joint</joint_name>
        <topic>/model/bellybot_dock_stack/extension_stage_target</topic>
        <initial_position>0</initial_position>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>0.7</cmd_max>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>yaw_joint</joint_name>
        <topic>/model/bellybot_dock_stack/yaw_target</topic>
        <initial_position>0</initial_position>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>1.0</cmd_max>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>tray_pitch_joint</joint_name>
        <topic>/model/bellybot_dock_stack/pitch_target</topic>
        <initial_position>0</initial_position>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>0.6</cmd_max>
      </plugin>
      <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
        <link>tray_belt</link>
        <velocity_topic>/model/bellybot_dock_stack/tray_belt_speed</velocity_topic>
        <track_orientation>0 3.141592653589793 0</track_orientation>
        <max_command_age>0.5</max_command_age>
        <min_velocity>-1.5</min_velocity>
        <max_velocity>1.5</max_velocity>
        <min_acceleration>-3</min_acceleration>
        <max_acceleration>3</max_acceleration>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>tray_rear_roller_joint</joint_name>
        <joint_name>tray_front_roller_joint</joint_name>
        <topic>/model/bellybot_dock_stack/tray_roller_speed</topic>
        <initial_velocity>0</initial_velocity>
        <use_force_commands>false</use_force_commands>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/model/bellybot_dock_stack/joint_states</topic>
      </plugin>
      <pose>4.1 0 0.003 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <topic>/model/bellybot_dock_stack/pose</topic>
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
    </model>
    <include>
      <uri>model://belt_loader</uri>
    </include>
    <include>
      <uri>model://door_belt</uri>
    </include>
  </world>
