<?xml version='1.0' encoding='utf-8'?>
<robot name="aircraft_environment">
  <link name="cargo_floor" />
  <link name="nb_hold_cutaway">
    <visual>
      <geometry>
        <mesh filename="package://bellybot_aircraft_environment/models/nb_hold_cutaway/meshes/visual.dae" scale="1 1 1" />
      </geometry>
    </visual>
  </link>
  <joint name="nb_hold_cutaway_fixed" type="fixed">
    <parent link="cargo_floor" />
    <child link="nb_hold_cutaway" />
  </joint>
  <link name="belt_loader">
    <visual>
      <geometry>
        <mesh filename="package://bellybot_aircraft_environment/models/belt_loader/meshes/visual.dae" scale="1 1 1" />
      </geometry>
    </visual>
  </link>
  <joint name="belt_loader_fixed" type="fixed">
    <parent link="cargo_floor" />
    <child link="belt_loader" />
  </joint>
</robot>